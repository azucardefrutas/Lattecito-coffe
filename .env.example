# Public site. Use `local` beside the POS, `snapshot` without storage, or `supabase` on Vercel.
APP_SURFACE=public
LATTECITO_CATALOG_MODE=local
# MOBILE_ADMIN_ENABLED=false
# Local SQLite directory only; leave unset on Vercel.
# LATTECITO_DATA_DIR=
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=  # Server only; never expose as NEXT_PUBLIC or EXPO_PUBLIC.
# MOBILE_ADMIN_AUTH_SECRET=  # At least 32 random characters.
# MOBILE_ADMIN_USERS_JSON=  # Salted password hashes only.

# Separate web catalog administrator (port 3002 locally).
# APP_SURFACE=catalog-admin
# CATALOG_ADMIN_ENABLED=true
