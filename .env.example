# Public site. Use `local` beside the POS, `snapshot` without storage, or `blob` on Vercel.
APP_SURFACE=public
LATTECITO_CATALOG_MODE=local
# Local SQLite directory only; leave unset on Vercel.
# LATTECITO_DATA_DIR=

# Separate web catalog administrator (port 3002 locally).
# APP_SURFACE=catalog-admin
# CATALOG_ADMIN_ENABLED=true
# BLOB_READ_WRITE_TOKEN=  # Injected by the Vercel Blob connection; never commit it.
